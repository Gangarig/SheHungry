# Copy the relevant values into each app's local environment file:
# apps/web/.env.local and apps/mobile/.env
# These are public client values. Never place a Supabase secret/service-role key
# in an app environment file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Temporary compatibility names for legacy Supabase projects (use only one key
# name per app):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
