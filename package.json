{
  "name": "@shehungry/mobile",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "mobile": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npm run dev --workspace=@shehungry/web",
    "web:build": "npm run build --workspace=@shehungry/web",
    "lint": "expo lint",
    "check": "npm run lint && npm run web:build"
  },
  "private": true,
  "packageManager": "npm@10.9.2"
}
