{
  "name": "shehungry",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "web": "npm run dev --workspace=@shehungry/web",
    "mobile": "npm run start --workspace=@shehungry/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:web": "npm run build --workspace=@shehungry/web"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@10.9.9",
  "engines": { "node": ">=22.13.0" }
}
